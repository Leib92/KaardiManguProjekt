@{
	ViewData["Title"] = "Admin";
}
@using Microsoft.AspNetCore.Identity
@inject SignInManager<KaardiManguProject.Core.Domain.ApplicationUser> signInManager;
@inject UserManager<KaardiManguProject.Core.Domain.ApplicationUser> userManager
@{
	var currentUser = await userManager.GetUserAsync(User);
}
@model KaardiManguProject.ViewModels.AdminChatlogViewModel;

@if (currentUser != null && currentUser.IsAdmin)
{
    <div class="v1_2">
	<div class="text-center">		
		<h1 class="display-6">Admin Chatlog View</h1>
		<p>You are an admin! Here you can view the logs and punish users!</p>
	</div>

	<form method="post">
		<div>From:</div>
		<input class="datefield" data-val="true" data-val-required="Date is required"
			   id="FromDate" name="FromDate" type="datetime" />
		<div>To:</div>
		<input class="datefield" data-val="true" data-val-required="Date is required"
			   id="ToDate" name="ToDate" type="datetime" />
		<input class="btn btn-outline-primary" type="submit" value="View Sorted">
	</form>
	<ul class="navbar-nav flex-grow-1">
		<li class="nav-item">
			<a class="btn btn-outline-primary" asp-area="" asp-controller="Admin" asp-action="ChatlogView">View All</a>
		</li>
	</ul>


            <div class="admin-container">
            <form method="get">
                <div class="chatlog-panel">
                    <h3>Chat Logs</h3>

                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.ChatLogs)
                            {
                                <tr>
                                    <td>@log.Date</td>
                                    <td>@log.MessageText</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="userinfo-panel">
                    <h3>User Info</h3>

                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>UserId</th>
                                <th>Name</th>
                                <th>AvatarRating</th>
                                <th>IsAdmin</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.ChatLogs)
                            {
                                var user = Model.Users.FirstOrDefault(u => u.Id == log.AccountID);

                                <tr>
                                    <td>@user.Id</td>
                                    <td>@user.AvatarName</td>
                                    <td>@user.AvatarRating</td>
                                    <td>@user.IsAdmin</td>
                                    <td>
                                        <a asp-action="PunishUser" asp-controller="Admin" asp-route-id="@log.AccountID">Punish</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </form>
            </div>



	</div>
}
else
{
	<div class="text-center">
		<h1 class="display-6">Admin Control Panel</h1>
		<p>You appear to have gotten to the Admin Control Panel while not being an admin, you dont get to see the correct text!</p>
	</div>
}