@{
    ViewData["Title"] = "Games";
}
<!--<script type="text/javascript" src="~/js/sprite.js"></script>
<script type="text/javascript" src="~/js/CardGame.png"></script>
<script type="text/html" src="~/js/Index.scss"></script>
<script type="text/javascript" src="~/js/Index.js"></script>-->
<script src="~/js/Index.js"></script>
<div class="text-center">
    <h1 class="display-6">Games Section</h1>
    <p>This is where you should be able to start game as either guest or registered user.</p>
    <p>I use <a href="https://bicyclecards.com/how-to-play/solitaire">this site</a> as an example for how it's supposed to work.</p>
</div>

    <div class="window">
        <div class="window__inner">
            <div class="window__heading">
                <div class="window__heading-icon"></div>
                Solitaire
            </div>
            <div class="window__actions">
                <button type="button" id="js-reset" class="new-game">New game</button>
            </div>
            <div class="window__content">
                <div class="window__content-inner">
                    <div class="solitaire" id="js-solitaire">
                        <div id="js-finish" class="finish-deck"></div>
                        <div id="js-board" class="board-deck"></div>

                        <div class="deck">
                            <div id="js-deck-pile" class="deck__pile"></div>
                            <div id="js-deck-deal" class="deck__deal"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

